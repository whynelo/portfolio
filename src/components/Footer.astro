---
import { brand, isPlaceholder, addressLines } from '../data/brand';
import { primaryNav, routes } from '../data/nav';

const year = new Date().getFullYear();
---

<footer class="hairline py-[3.25rem]">
  <div class="page-grid">
    <div class="flex flex-col gap-4">
      <p class="display h3 m-0">{brand.displayName}</p>
      <p class="small text-ink-muted m-0">{brand.role}</p>
      <p class="small m-0">
        <a class="btn-ghost-text" href={`mailto:${brand.email}`}>{brand.email}</a>
      </p>
      <p class="label m-0">
        {addressLines().map((line) => (
          <span class="block">{isPlaceholder(line) ? `${line}` : line}</span>
        ))}
      </p>
    </div>
    <div class="flex flex-col gap-3 md:items-end md:text-right">
      <nav class="flex flex-wrap gap-x-4 gap-y-2 md:justify-end" aria-label="Seiten">
        {
          primaryNav.map((item) => (
            <a class="small text-ink-muted hover:text-ink" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav class="flex flex-wrap gap-x-4 gap-y-2 md:justify-end" aria-label="Rechtliches">
        <a class="small text-ink-muted hover:text-ink" href={routes.impressum}>Impressum</a>
        <a class="small text-ink-muted hover:text-ink" href={routes.datenschutz}>Datenschutz</a>
      </nav>
      <p class="label m-0">© {year} {brand.legalName}</p>
      <p class="label m-0">§ 5 DDG · kein ODR-Link</p>
    </div>
  </div>
</footer>
