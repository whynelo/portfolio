---
type Props = {
  src: string;
  alt: string;
  lqip?: string;
  kind?: 'photo' | 'diagram';
  eager?: boolean;
};

const { src, alt, lqip, kind = 'photo', eager = false } = Astro.props;
---

<div
  class:list={['thumb', kind === 'diagram' && 'is-diagram']}
  style={lqip ? `background-image: url('${lqip}'); background-size: cover;` : undefined}
>
  {
    kind === 'diagram' ? (
      <img class="thumb-img is-on" src={src} alt={alt} />
    ) : (
      <img
        class="thumb-img"
        src={src}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        data-blurup
      />
    )
  }
</div>
