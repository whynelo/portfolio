---
import Base from '../layouts/Base.astro';
---

<Base title="Seite fehlt — Klaas Leeck" description="Diese Adresse gibt es hier nicht.">
  <section class="page-grid min-h-[70dvh] items-end py-[7.5rem]">
    <div>
      <p class="label mb-3">404</p>
      <h1 class="display h1">Die Seite gibt’s nicht.</h1>
      <p class="body measure mt-6 text-ink-muted">
        Falsche URL. Zurück zur Startseite — oder schreib mir einfach.
      </p>
      <p class="mt-8">
        <a class="btn-primary" href="/">Zurück zur Startseite</a>
      </p>
    </div>
    <p class="label">Ein Link reicht.</p>
  </section>
</Base>
