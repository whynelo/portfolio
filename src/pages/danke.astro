---
import Base from '../layouts/Base.astro';
import { thanks } from '../data/content';
---

<Base title="Danke — Klaas Leeck" description="Anfrage gesendet.">
  <section class="page-grid min-h-[70dvh] items-end py-[7.5rem]">
    <div>
      <p class="label mb-3">06 · Projekt</p>
      <h1 class="display h1">{thanks.title}</h1>
      <p class="body measure mt-6 text-ink-muted">{thanks.body}</p>
      <p class="mt-8">
        <a class="btn-primary" href="/">{thanks.back}</a>
      </p>
    </div>
      <p class="label">Danke.</p>
  </section>
</Base>
